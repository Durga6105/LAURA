# =========================================================
# LAURA Environment Configuration Example
# =========================================================

# Application
APP_NAME=LAURA
APP_ENV=development
DEBUG=true

# =========================================================
# Gemini
# =========================================================

# Put your own Gemini API key here in the real .env file.
# NEVER commit the real key to GitHub.
GEMINI_API_KEY=

# Gemini model
GEMINI_MODEL=gemini-3.5-flash